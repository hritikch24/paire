# Copy to .env for local development (git-ignored). Release builds read
# .env.production instead; see docs/RELEASE.md.

# Firebase web config (public identifiers, not secrets). Leave unset to use the
# production project built into src/config/env.ts.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Must match FUNCTIONS_REGION in firebase/functions/.env.
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1

# Shown in the app for support and required for release builds.
EXPO_PUBLIC_SUPPORT_EMAIL=
# Where the privacy policy, terms and deletion pages are hosted.
EXPO_PUBLIC_LEGAL_BASE_URL=https://muse-352ba.web.app

# Development only (ignored by release builds): use the local Firebase emulators.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Development only: Maestro test mode (skips the system photo picker).
EXPO_PUBLIC_E2E=false

# Optional authenticated 8x8 JaaS calls; server signing keys are required.
# EXPO_PUBLIC_CALL_DOMAIN=

# Public RevenueCat SDK keys (never the secret REST or webhook keys).
# Live purchases require a native build, server setup and configured store products.
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
