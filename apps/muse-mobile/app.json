{
  "expo": {
    "name": "Muse",
    "slug": "muse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5F2EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muse.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Muse needs photo access to build your profile.",
        "NSLocationWhenInUseUsageDescription": "Muse uses your location to show how far away matches are."
      }
    },
    "android": {
      "package": "com.muse.app",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F2EF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
