{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix apps/muse-mobile --ignore-scripts --no-audit --no-fund",
  "buildCommand": "node apps/web/scripts/build.mjs",
  "outputDirectory": "apps/web/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/v/",
      "destination": "https://us-central1-muse-352ba.cloudfunctions.net/trackVisit"
    },
    {
      "source": "/pay/ccavenue/",
      "destination": "https://us-central1-muse-352ba.cloudfunctions.net/ccavenueResponse"
    },
    {
      "source": "/metrics",
      "has": [
        {
          "type": "query",
          "key": "key",
          "value": "admin"
        }
      ],
      "destination": "/_d6ad65113cb02b1461f/"
    },
    {
      "source": "/metrics/",
      "has": [
        {
          "type": "query",
          "key": "key",
          "value": "admin"
        }
      ],
      "destination": "/_d6ad65113cb02b1461f/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(self), payment=(self \"https://api.razorpay.com\" \"https://checkout.razorpay.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/_expo/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/_d6ad65113cb02b1461f/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/metrics(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/paire-push-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
