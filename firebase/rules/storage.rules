rules_version = '2';

// Profile photos live at user-uploads/{uid}/photos/{file}. Only the owner can
// write them, uploads must be images under 10 MB, and signed-in members can
// fetch a photo they were given (the app shows photos via download URLs).
// Listing a folder is owner-only, so a member's photos can't be enumerated from
// their uid (private photos are left out of discovery until a match).
service firebase.storage {
  match /b/{bucket}/o {
    // Verified snapshots are created only by the server. No member may replace or delete them.
    match /verified-photos/{uid}/{attempt}/{fileName} {
      allow get: if request.auth != null && !('supportSession' in request.auth.token);
      allow list: if false;
      allow write: if false;
    }
    match /user-uploads/{uid}/photos/{fileName} {
      allow get: if request.auth != null && !('supportSession' in request.auth.token);
      allow list: if request.auth != null && !('supportSession' in request.auth.token) && request.auth.uid == uid;
      allow create, update: if request.auth != null && !('supportSession' in request.auth.token)
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
      allow delete: if request.auth != null && !('supportSession' in request.auth.token) && request.auth.uid == uid;
    }
  }
}
