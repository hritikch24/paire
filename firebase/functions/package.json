{
  "name": "muse-functions",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud Functions for Muse: discovery, swipes/matching, safety, account deletion and push notifications.",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth,storage",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199 GCLOUD_PROJECT=demo-muse node scripts/seed.js",
    "test:integration": "jest -c jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.5.0",
    "onnxruntime-web": "^1.22.0",
    "sharp": "^0.34.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9.31.0",
    "firebase": "^10.12.5",
    "globals": "^15.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2"
  }
}
