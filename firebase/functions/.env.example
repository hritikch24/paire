# Copy to firebase/functions/.env (git-ignored) to override defaults at deploy time.
# Keep this in the same location as the Firestore database, and mirror it in the
# app's EXPO_PUBLIC_FUNCTIONS_REGION.
FUNCTIONS_REGION=us-central1

# Off until provider accounts, products, signed callbacks and live QA are ready.
# Secrets go in Firebase Secret Manager, never in EXPO_PUBLIC_* variables.
MUSE_VERIFICATION_ENABLED=false
DIDIT_WORKFLOW_ID=
DIDIT_APPLICATION_ID=
MUSE_BILLING_ENABLED=false
# Razorpay (web Paire Plus passes). The key id is public; RAZORPAY_KEY_SECRET and
# RAZORPAY_WEBHOOK_SECRET go in Secret Manager (firebase functions:secrets:set NAME).
RAZORPAY_KEY_ID=
# Razorpay Checkout on kraftai.in (the site KraftAI's Razorpay account is registered for):
# orders still come from here and are still verified here; only the Checkout page moves.
# Required for new Razorpay orders; unset refuses checkout. The host must be KraftAI
# (or localhost for tests). The server always uses the /pay/start entry route.
KRAFTAI_CHECKOUT_URL=https://kraftai.in/pay/start
# Payment display names: use matching values in kanoon-simplified's environment.
# Unset/blank values use the defaults. Full labels override the generated names.
# Changes take effect after deploying; product IDs and prices stay the same.
PAIRE_PLUS_NAME=Paire Plus
PAIRE_CHAT_NAME=Paire Unlimited Chat
PAIRE_PLUS_DAY_LABEL=
PAIRE_PLUS_WEEK_LABEL=
PAIRE_PLUS_MONTH_LABEL=
PAIRE_CHAT_LABEL=
# Descriptions for Razorpay, independent of the labels on our own pages.
# E.g. RAZORPAY_PLUS_NAME=KraftAI Plus with PAIRE_PLUS_NAME=Paire Plus.
# Unset uses KraftAI names; per-plan overrides take precedence.
RAZORPAY_PLUS_NAME=KraftAI Plus
RAZORPAY_CHAT_NAME=KraftAI Unlimited Chat
RAZORPAY_PLUS_DAY_LABEL=
RAZORPAY_PLUS_WEEK_LABEL=
RAZORPAY_PLUS_MONTH_LABEL=
RAZORPAY_CHAT_LABEL=
KRAFTAI_CHECKOUT_NAME=KraftAI
# Sandbox purchases can grant passes only in the Functions emulator. For Unlimited
# Chat it also allows selling with a rzp_test_ key; outside the emulator a test-mode
# payment can only ever unlock test-cohort accounts (moderation/{uid}.cohort = "test").
MUSE_BILLING_SANDBOX=false
# Unlimited Chat (₹49 once). Both off until Razorpay approves a merchant account for
# Paire itself. Sales also need runtime/trust.unlockSales (scripts/set-runtime-flags.mjs);
# MUSE_CHAT_UNLOCK_LIVE=true is the explicit approval to sell with a rzp_live_ key.
MUSE_CHAT_UNLOCK_ENABLED=false
MUSE_CHAT_UNLOCK_LIVE=false
# Unlimited Chat by UPI into Paire's own account: the UPI ID buyers pay and the name shown.
# Sales also need runtime/trust.upiSales; a moderator approves each payment (UTR) in the app.
MUSE_UPI_VPA=
MUSE_UPI_PAYEE_NAME=Paire
# CCAvenue (cards, UPI, netbanking, wallets) for Unlimited Chat and Plus on the web.
# Off until CCAvenue approves a merchant account for Paire. CCAVENUE_ENV is test or
# live and must match the keys. The working key is a secret:
#   firebase functions:secrets:set CCAVENUE_WORKING_KEY   (enter "disabled" until you have one)
# Sales also need runtime/trust.ccavenueSales (--ccavenue-sales on). A test key sells
# only with MUSE_BILLING_SANDBOX=true (test-cohort accounts only, outside the emulator);
# MUSE_CCAVENUE_LIVE=true is the explicit approval to take live money.
# CCAvenue returns buyers to https://www.paire.in/pay/ccavenue/ (vercel.json forwards it to
# the ccavenueResponse function), on the site the keys are registered for. Override with
# CCAVENUE_RESPONSE_URL only for another site.
MUSE_CCAVENUE_ENABLED=false
MUSE_CCAVENUE_LIVE=false
CCAVENUE_ENV=test
CCAVENUE_MERCHANT_ID=
CCAVENUE_ACCESS_CODE=
CCAVENUE_RESPONSE_URL=
# Where members land after paying (the browser app).
MUSE_APP_URL=https://www.paire.in/app/
# Presence and the paid-chat sending gate are runtime switches, not variables:
# runtime/presence and the paid-chat fields of runtime/trust (docs/presence-and-paid-chat.md).
MUSE_MATCHING_MODEL=claude-haiku-5-5
# Optional authenticated 8x8 calls. See docs/production-integrations.md.
JAAS_APP_ID=
JAAS_KEY_ID=
